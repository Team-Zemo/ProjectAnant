# fir_diary.gbnf
# GBNF grammar for Police Case Diary / FIR narrative section
# Only the narrative prose is generated by the model.
# All structured data (account numbers, amounts, timestamps) is injected by code.

root ::= diary-object

diary-object ::= "{" ws
    "\"document_type\":" ws "\"POLICE_CASE_DIARY\"" ws "," ws
    "\"case_summary\":" ws prose-text ws "," ws
    "\"modus_operandi\":" ws prose-text ws "," ws
    "\"layer_analysis\":" ws prose-text ws "," ws
    "\"recommended_actions\":" ws actions-array ws
    "}" ws

prose-text ::= "\"" prose-chars "\""
prose-chars ::= ( [^"\\\n] | "\\" ["\\/bfnrt] )*

actions-array ::= "[" ws action-item ( ws "," ws action-item )* ws "]"
action-item ::= "\"" ( "Immediate freeze of subject account" |
                        "Obtain bank statement for 90 days" |
                        "Issue summons to account holder" |
                        "Coordinate with cyber cell" |
                        "Flag for PMLA reporting" |
                        "Check nominee details" |
                        "Trace terminal beneficiaries" )
                "\"" 

ws ::= [ \t\n]*
